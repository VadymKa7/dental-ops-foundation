# Copy to .env for local uv/uvicorn runs. Docker Compose sets its own environment.
# These values are local placeholders, not production secrets.

APP_NAME=Dental Operations Intelligence
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://dental:dental@localhost:5432/dental
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Reserved for a future worker. The API process does not connect to Redis.
REDIS_URL=redis://localhost:6379/0

# Integration tests read TEST_DATABASE_URL from the process environment, not from this file.
# Export it in the shell. Do not point it at a database that holds real data.
# TEST_DATABASE_URL=postgresql+asyncpg://dental:dental@localhost:5432/dental_test
